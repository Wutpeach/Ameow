---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const releasesUrl = 'https://github.com/Wutpeach/Ameow/releases/latest';
const releaseNotesUrl = `${base}docs/releases/`;
const githubUrl = 'https://github.com/Wutpeach/Ameow';
const docsUrl = `${base}docs/getting-started/`;
const screenshots = [
	{
		src: `${base}images/preview-desktop.svg`,
		alt: 'Ameow 桌面悬浮窗口预览',
		caption: '桌面悬浮入口',
	},
	{
		src: `${base}images/preview-browser.svg`,
		alt: 'Ameow 浏览器扩展预览',
		caption: '浏览器联动',
	},
	{
		src: `${base}images/preview-settings.svg`,
		alt: 'Ameow 设置界面预览',
		caption: '可控设置',
	},
];
const workflows = [
	{
		title: '拖进文件',
		body: '文件和文件夹都可以直接交给桌面悬浮窗口，收集到当前输出目录。',
	},
	{
		title: '粘贴链接',
		body: '复制图片、视频或页面链接后粘贴进 Ameow，下载队列会接管后续进度。',
	},
	{
		title: '网页发送到桌面',
		body: '浏览器扩展把视频链接、Cookies 和下载偏好传给桌面端，减少来回切换。',
	},
];
const platforms = ['Windows Installer EXE', 'Windows Portable ZIP', 'macOS Apple Silicon DMG'];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Ameow 是一个常驻桌面的悬浮下载与收集窗口，拖拽文件、粘贴链接，网页里的内容也能直接发到桌面。"
		/>
		<title>Ameow | 桌面悬浮下载与收集窗口</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="site-header" aria-label="主导航">
				<a class="brand" href={base} aria-label="Ameow 首页">
					<span class="brand-mark">A</span>
					<span>Ameow</span>
				</a>
				<nav>
					<a href={docsUrl}>文档</a>
					<a href={releasesUrl}>下载</a>
					<a href={githubUrl}>GitHub</a>
				</nav>
			</header>

			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">桌面边缘的收集入口</p>
					<h1>
						<span>拖拽、粘贴，</span>
						<span>网页发送，</span>
						<span>都交给同一个</span>
						<span>悬浮窗口。</span>
					</h1>
					<p class="lede">
						Ameow 常驻桌面边缘，把本地文件、网页视频、图片链接和浏览器里的内容集中送到一个可控输出目录。
					</p>
					<div class="hero-actions">
						<a class="button primary" href={releasesUrl}>下载 Ameow</a>
						<a class="button secondary" href={docsUrl}>阅读文档</a>
					</div>
					<ul class="platforms" aria-label="当前发布平台">
						{platforms.map((platform) => <li>{platform}</li>)}
					</ul>
				</div>
				<div class="hero-stage" aria-label="产品预览">
					<img class="main-preview" src={`${base}images/preview-desktop.svg`} alt="Ameow 桌面窗口界面" />
					<div class="status-strip">
						<span>Output: Desktop/Ameow_Received</span>
						<span>3 concurrent downloads</span>
					</div>
				</div>
			</section>

			<section class="showcase" aria-label="产品界面预览">
				{screenshots.map((item) => (
					<figure>
						<img src={item.src} alt={item.alt} />
						<figcaption>{item.caption}</figcaption>
					</figure>
				))}
			</section>

			<section class="workflow-section">
				<div class="section-heading">
					<p class="eyebrow">常用流程</p>
					<h2>不改变桌面习惯，只减少中间步骤。</h2>
				</div>
				<div class="workflow-list">
					{workflows.map((item, index) => (
						<article>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="extension-band">
				<div>
					<p class="eyebrow">浏览器扩展</p>
					<h2>网页里的下载意图，可以直接发到桌面。</h2>
					<p>
						扩展通过本地连接把视频链接、Cookies 和质量偏好交给 Ameow。桌面端负责下载队列、进度和输出目录。
					</p>
					<a class="text-link" href={`${base}docs/browser-extension/`}>查看扩展安装与连接说明</a>
				</div>
				<img src={`${base}images/extension-install.svg`} alt="浏览器扩展安装步骤预览" />
			</section>
		</main>

		<footer class="site-footer">
			<span>Ameow</span>
			<a href={docsUrl}>文档</a>
			<a href={releaseNotesUrl}>Release Notes</a>
			<a href={githubUrl}>GitHub</a>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: oklch(15% 0.012 286);
		--surface: oklch(20% 0.014 286);
		--surface-strong: oklch(25% 0.016 286);
		--text: oklch(95% 0.006 286);
		--muted: oklch(74% 0.012 286);
		--dim: oklch(57% 0.018 286);
		--line: oklch(36% 0.016 286);
		--accent: oklch(64% 0.18 255);
		--accent-strong: oklch(58% 0.2 255);
		--cyan: oklch(78% 0.12 214);
		--green: oklch(76% 0.16 158);
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background:
			radial-gradient(circle at 78% 8%, oklch(36% 0.1 255 / 0.35), transparent 28rem),
			radial-gradient(circle at 18% 38%, oklch(30% 0.08 178 / 0.22), transparent 24rem),
			linear-gradient(180deg, oklch(18% 0.014 286), var(--bg));
		color: var(--text);
		min-height: 100vh;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}

	.page-shell {
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 22px 0;
		gap: 20px;
	}

	.brand,
	.site-header nav {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.brand {
		font-weight: 800;
		font-size: 1rem;
	}

	.brand-mark {
		display: grid;
		width: 32px;
		height: 32px;
		place-items: center;
		border: 1px solid oklch(58% 0.08 255 / 0.42);
		border-radius: 11px;
		background: linear-gradient(145deg, oklch(26% 0.03 286), oklch(18% 0.02 286));
		color: var(--cyan);
		box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.1);
	}

	.site-header nav {
		color: var(--muted);
		font-size: 0.92rem;
	}

	.site-header nav a {
		padding: 8px 10px;
		border-radius: 10px;
	}

	.site-header nav a:hover {
		background: oklch(100% 0 0 / 0.06);
		color: var(--text);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
		align-items: center;
		min-height: calc(100vh - 84px);
		padding: 40px 0 92px;
		gap: clamp(36px, 7vw, 88px);
	}

	.eyebrow {
		margin: 0 0 18px;
		color: var(--cyan);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 24px;
		max-width: 9ch;
		font-size: clamp(4.8rem, 8.4vw, 7.4rem);
		line-height: 0.95;
		letter-spacing: 0;
	}

	h1 span {
		display: block;
		white-space: nowrap;
	}

	.lede {
		max-width: 36rem;
		color: var(--muted);
		font-size: clamp(1.08rem, 2vw, 1.28rem);
		line-height: 1.75;
	}

	.hero-actions,
	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-actions {
		margin-top: 30px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		border-radius: 13px;
		padding: 0 18px;
		font-weight: 800;
		border: 1px solid transparent;
		transition:
			transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
			background 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(180deg, var(--accent), var(--accent-strong));
		color: oklch(98% 0.006 255);
		box-shadow: 0 18px 44px oklch(50% 0.16 255 / 0.28);
	}

	.secondary {
		border-color: oklch(62% 0.07 255 / 0.5);
		background: oklch(100% 0 0 / 0.055);
		color: var(--text);
	}

	.platforms {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.platforms li {
		border: 1px solid oklch(64% 0.05 286 / 0.38);
		border-radius: 999px;
		padding: 8px 11px;
		background: oklch(100% 0 0 / 0.035);
	}

	.hero-stage {
		position: relative;
		padding: clamp(18px, 4vw, 34px);
		border: 1px solid oklch(58% 0.08 255 / 0.36);
		border-radius: 28px;
		background:
			linear-gradient(135deg, oklch(100% 0 0 / 0.1), transparent 36%),
			linear-gradient(180deg, var(--surface-strong), var(--surface));
		box-shadow:
			0 40px 90px oklch(4% 0.01 286 / 0.48),
			inset 0 1px 0 oklch(100% 0 0 / 0.1);
	}

	.main-preview {
		width: 100%;
		border-radius: 20px;
		box-shadow: 0 22px 60px oklch(4% 0.01 286 / 0.3);
	}

	.status-strip {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin-top: 16px;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.showcase {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr 0.9fr;
		gap: 16px;
		padding: 0 0 92px;
	}

	.showcase figure {
		margin: 0;
		overflow: hidden;
		border: 1px solid oklch(56% 0.05 286 / 0.28);
		border-radius: 22px;
		background: var(--surface);
	}

	.showcase img {
		width: 100%;
		height: 100%;
		min-height: 230px;
		object-fit: cover;
	}

	.showcase figcaption {
		padding: 12px 14px 14px;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.workflow-section {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(28px, 7vw, 84px);
		padding: 86px 0;
		border-top: 1px solid oklch(52% 0.05 286 / 0.24);
	}

	.section-heading h2,
	.extension-band h2 {
		font-size: clamp(2.1rem, 5vw, 4.6rem);
		line-height: 1;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.workflow-list {
		display: grid;
		gap: 16px;
	}

	.workflow-list article {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: 18px;
		padding: 22px 0;
		border-bottom: 1px solid oklch(52% 0.05 286 / 0.24);
	}

	.workflow-list span {
		color: var(--green);
		font-weight: 900;
		font-size: 1.4rem;
	}

	.workflow-list h3 {
		margin-bottom: 8px;
		font-size: 1.25rem;
	}

	.workflow-list p,
	.extension-band p {
		color: var(--muted);
		line-height: 1.75;
	}

	.extension-band {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(320px, 1.08fr);
		align-items: center;
		gap: clamp(32px, 7vw, 86px);
		padding: 74px clamp(20px, 5vw, 56px);
		border: 1px solid oklch(58% 0.08 255 / 0.34);
		border-radius: 28px;
		background:
			radial-gradient(circle at 92% 10%, oklch(68% 0.13 214 / 0.18), transparent 22rem),
			linear-gradient(180deg, oklch(22% 0.016 286), oklch(17% 0.013 286));
	}

	.extension-band img {
		border-radius: 20px;
		box-shadow: 0 22px 60px oklch(4% 0.01 286 / 0.3);
	}

	.text-link {
		display: inline-flex;
		margin-top: 12px;
		color: var(--cyan);
		font-weight: 800;
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
		padding: 48px 0 34px;
		color: var(--muted);
	}

	.site-footer span {
		color: var(--text);
		font-weight: 800;
	}

	@media (max-width: 900px) {
		.hero,
		.workflow-section,
		.extension-band {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
			padding-top: 28px;
		}

		h1 {
			max-width: 8.5ch;
		}

		.showcase {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 580px) {
		.page-shell,
		.site-footer {
			width: min(100% - 22px, 1180px);
		}

		.site-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.site-header nav {
			width: 100%;
			justify-content: space-between;
		}

		h1 {
			font-size: clamp(2.8rem, 12.6vw, 3.5rem);
		}

		.status-strip,
		.workflow-list article {
			grid-template-columns: 1fr;
			flex-direction: column;
		}
	}
</style>
