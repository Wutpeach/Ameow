---
interface Props { kind: 'cancel' | 'retry' | 'copy' | 'clear'; }
const { kind } = Astro.props;
// Native 14px / 1.2px paths from download_ui::queue_icon_drawing.
const paths = {
  cancel: ['3.5,3.5 10.5,10.5','10.5,3.5 3.5,10.5'],
  retry: ['11.8,5.3 10.5,3.4 8.5,2.4 6.1,2.5 4.1,3.7 3.1,5.8 3.2,8.2 4.6,10.3 6.7,11.2 9.1,10.8 10.8,9.3','11.8,2.3 11.8,5.5 8.6,5.5'],
  copy: ['5,5 11.5,5 11.5,11.5 5,11.5 5,5','8.5,2.5 2.5,2.5 2.5,8.5'],
  clear: ['2.4,4 11.6,4','5,4 5,2.5 9,2.5 9,4','3.5,4 4.1,11.5 9.9,11.5 10.5,4','5.7,6.2 5.9,9.3','8.3,6.2 8.1,9.3'],
};
---
<span class:list={['queue-glyph',kind]} aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">{paths[kind].map(points=><polyline points={points} />)}</svg></span>
<style>.queue-glyph { display: inline-grid; place-items: center; width: 24px; height: 24px; flex: none; }.clear { color: var(--fig-red); opacity: .8; }</style>
