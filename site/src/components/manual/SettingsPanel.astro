---
import AppIcon from './AppIcon.astro';
interface Props { page: 'general' | 'download'; en?: boolean; }
const { page, en = false } = Astro.props;
const t = (zh: string, english: string) => en ? english : zh;
const navigation = [
  { id: 'general', icon: 'sliders' as const, label: t('常规', 'General') },
  { id: 'download', icon: 'download' as const, label: t('下载', 'Download') },
  { id: 'components', icon: 'blocks' as const, label: t('组件与诊断', 'Components') },
  { id: 'about', icon: 'info' as const, label: t('关于', 'About') },
];
const preferences = [[t('主题', 'Theme'), t('跟随系统', 'System')], [t('语言', 'Language'), t('跟随系统', 'System')], [t('托盘图标', 'Tray icon'), t('跟随外观', 'Follow appearance')]];
---
<p class="pan-guide">{t('左右滑动查看完整界面', 'Swipe sideways to see the full interface')}</p>
<div class="viewport" role="region" data-settings-viewport tabindex="0" aria-label={t('下载设置，可横向滚动查看', 'Download settings; scroll horizontally to view')}>
  <div class="panel">
    <div class="sidebar">{navigation.map(item => <span class:list={['nav', { selected: item.id === page }]}><AppIcon name={item.icon} size={14} /><span>{item.label}</span></span>)}</div>
    <div class="content">
      <strong class="title">{page === 'general' ? t('常规', 'General') : t('下载', 'Download')}</strong>
      {page === 'general' ? <>
        <div class="row"><span>{t('开机启动', 'Launch at login')}</span><span class="switch"><span /></span></div>
        {preferences.map(([label, value]) => <div class="row"><span>{label}</span><span class="select"><span>{value}</span><AppIcon name="down" size={12} /></span></div>)}
        <div class="section-title">{t('快捷键', 'Shortcut')}</div>
        <div class="row"><span>{t('呼出／隐藏 Ameow', 'Show / hide Ameow')}</span><span class="select">Ctrl+Shift+F</span></div>
      </> : <>
        <div class="row"><span>{t('下载位置', 'Download location')}</span><span class="actions"><span class="icon"><AppIcon name="folderOpen" /></span><span class="change">{t('更改', 'Change')}</span></span></div>
        <div class="path"><span>C:&#92;Downloads</span><span class="icon"><AppIcon name="copy" /></span></div>
      </>}
    </div>
  </div>
</div>
<script>
  for (const viewport of document.querySelectorAll<HTMLElement>('[data-settings-viewport]')) if (matchMedia('(max-width:40rem)').matches) requestAnimationFrame(() => { viewport.scrollLeft = 144; });
</script>
<style>
  .pan-guide { display: none; padding-bottom: 12px; color: var(--fig-muted); font: 14px/1.5 var(--sl-font); }
  .viewport:focus-visible { outline: 2px solid var(--fig-blue); outline-offset: 3px; }
  .viewport { overflow: hidden; border-radius: 12px; }
  .panel { display: grid; grid-template-columns: 144px 1fr; min-width: 550px; background: var(--fig-surface); color: var(--fig-text); font: 13px/20px "Segoe UI", "Microsoft YaHei UI", sans-serif; }
  .sidebar { display: flex; flex-direction: column; gap: 4px; padding: 16px 12px; background: color-mix(in srgb, var(--fig-badge) 55%, var(--fig-surface)); }
  .nav { display: flex; align-items: center; gap: 8px; height: 36px; padding: 0 8px; border-radius: 6px; color: var(--fig-muted); white-space: nowrap; }
  .nav.selected { color: var(--fig-text); background: var(--fig-border); }
  .content { min-width: 0; padding: 20px 24px 24px; }
  .title { display: block; margin-bottom: 16px; font-size: 15px; font-weight: 500; }
  .row { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .select { display: flex; align-items: center; justify-content: space-between; flex: none; width: 192px; height: 32px; padding: 0 10px; border: 1px solid var(--fig-border); border-radius: 6px; }
  .section-title { margin-top: 24px; font-size: 13px; font-weight: 500; }
  .switch { width: 32px; height: 18px; padding: 3px; border-radius: 9px; background: color-mix(in srgb, var(--fig-muted) 30%, transparent); }
  .switch > span { display: block; width: 12px; height: 12px; border-radius: 50%; background: var(--fig-surface); }
  .actions { display: flex; align-items: center; gap: 8px; }
  .icon { display: grid; place-items: center; width: 32px; height: 32px; color: var(--fig-muted); flex: none; }
  .change { display: grid; place-items: center; height: 32px; padding: 0 12px; border: 1px solid var(--fig-border); border-radius: 6px; }
  .path { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 6px 6px 6px 12px; border-radius: 6px; background: color-mix(in srgb, var(--fig-badge) 55%, transparent); font-size: 12px; }
  @media (max-width: 40rem) { .pan-guide { display: block; } .viewport { overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--fig-border) transparent; } }
</style>
