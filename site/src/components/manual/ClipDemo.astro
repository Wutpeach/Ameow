---
interface Props { lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
const src = import.meta.env.BASE_URL.replace(/\/$/,'') + '/manual/browser/clip.html';
---
<figure class="clip-demo" data-figure="clip-demo">
  <ameow-clip-demo data-lang={lang} role="group" aria-label={t('在切片界面标记并拖动片段边界', 'Mark and drag clip boundaries in the extension interface')}>
    <iframe src={src} title={t('Ameow 切片界面，使用示例视频', 'Ameow clip interface with an example video')} sandbox="allow-scripts allow-same-origin" />
    <div class="playback"><button data-play type="button" aria-pressed="false">{t('播放', 'Play')}</button><button data-replay type="button">{t('重播', 'Replay')}</button></div>
    <nav class="stages" aria-label={t('操作步骤', 'Steps')}>{[['0',t('定位','Seek')],['3',t('打点','Mark')],['8',t('选区','Range')],['11',t('清空','Clear')]].map(([step,label]) => <button data-step={step} type="button"><span>{label}</span><span class="stage-track" aria-hidden="true"><span /></span></button>)}</nav>
    <span class="sr-only" data-status role="status" />
  </ameow-clip-demo>
</figure>
<script>import './product-clip.js';</script>
<style>
  .clip-demo { margin: 1.75rem 0 2rem; font: 14px/1.6 var(--sl-font); }
  ameow-clip-demo { display: block; }
  iframe { display: block; width: 360px; max-width: 100%; height: 380px; margin: 0 auto; border: 0; border-radius: 12px; }
  button { color: var(--sl-color-gray-2); background: transparent; border: 0; border-radius: 6px; font: inherit; cursor: pointer; }
  button:hover { background: var(--sl-color-bg-sidebar); }
  button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .playback { display: flex; gap: 4px; margin-top: 8px; }
  .playback button { min-height: 36px; padding: 5px 10px; }
  .stages { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--sl-color-hairline); }
  .stages button { min-width: 0; min-height: 44px; padding: 0 0 8px; text-align: left; }
  .stages button[aria-current='true'] { color: var(--sl-color-text); }
  .stage-track { display: block; height: 4px; margin-top: 10px; border-radius: 3px; background: var(--sl-color-hairline); }
  .stage-track>span { display: block; width: var(--stage-fill,0%); height: 100%; background: var(--sl-color-gray-2); border-radius: inherit; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
