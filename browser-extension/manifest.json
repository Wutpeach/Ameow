{
  "manifest_version": 3,
  "name": "Ameow",
  "version": "0.5.3",
  "description": "在播放器旁下载整段或选择片段，按需授权站点会话到本机 Ameow。",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "cookies", "storage", "alarms", "nativeMessaging", "scripting", "clipboardWrite"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.bilibili.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Ameow 下载与站点授权", "default_icon": { "16": "icons/16.png", "24": "icons/24.png", "32": "icons/32.png" } },
  "incognito": "not_allowed"
}
